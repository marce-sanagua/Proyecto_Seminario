<%- include ("partials/head.ejs") %>
<%- include ("partials/header.ejs") %>

    <main>
        <h1>Listado productos</h1>
        <section id="contenedor-productos"></section>
    </main>

    <script>
        let contenedorProductos = document.getElementById("contenedor-productos");

        
        function mostrarError(string) {
            contenedorProductos.innerHTML = `
                <p class="mensaje error">${string}</p>
            `;
        }

        async function obtenerProductos() {
            try {
                let url = "/api/products/";
                let response = await fetch(url);
                console.log(response); 

                let data = await response.json();

                
                if (!response.ok) {
                    console.log(data.message);
                    return mostrarError(data.message);
                }

                console.table(data.payload);
                renderizarProductos(data.payload); 

            
            } catch (error) {
                console.error(error);
                mostrarError("Error en la conexion con el servidor");
            }
        }


        function renderizarProductos(array) {
            let htmlProducto = "";

            array.forEach(producto => {
                htmlProducto += `
                <div class="card-producto">
                    <img src="${producto.image}" alt="${producto.name}">
                    <h3>${producto.name}</h3>
                    <p>Id: ${producto.id}</p>
                    <p>$${producto.price}</p>
                </div>`;
            });

            contenedorProductos.innerHTML = htmlProducto;
        }

        obtenerProductos();
    </script>
</body>
</html>