 <%- include ("partials/head.ejs") %>
 <%- include ("partials/header.ejs") %>
    
    <main>
        <h1>Consultar producto por id</h1>

       
        <form id="altaProducts-form">

            <label for="categoryProd">Categoria</label>
            <select name="category" id="categoryProd" required>
                <option value="food">food</option>
                <option value="drink">drink</option>
            </select>


            <label for="imageProd">Imagen</label>
            <input type="text" name="image" id="imageProd" required>


            <label for="nameProd">Nombre</label>
            <input type="text" name="name" id="nameProd" required>


            <label for="priceProd">Precio</label>
            <input type="number" name="price" id="priceProd" required>


            <input type="submit" value="Crear producto">
        </form>


        <section id="contenedor-productos"></section>
    </main>


    <script>
        let altaProductsForm = document.getElementById("altaProducts-form");
        let contenedorProductos = document.getElementById("contenedor-productos");

        
        function mostrarMensaje(type, message) {
            contenedorProductos.innerHTML = `
                <p class="mensaje ${type}">${message}</p>
            `;
        }

        altaProductsForm.addEventListener("submit", async event => {

            event.preventDefault(); 

            const formData = new FormData(event.target);
            console.log(formData); 

            const data = Object.fromEntries(formData.entries());
            console.table(data);

            
            data.price = Number(data.price); 
            data.name = data.name.trim(); 

            const urlBase = "http://localhost:3000";

            try {
                const response = await fetch(`${urlBase}/api/products`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(data)
                });

                console.log(response);

                const result =await response.json();

                if(response.ok){
                                        
                    const stringRespuesta = `${result.message} con id ${result.productId}`
                    console.log(stringRespuesta);

                    mostrarMensaje("exito",stringRespuesta);

                }else{
                    return mostrarMensaje("error", result.message);
                }

                
            } catch (error) {
                console.error("Error al enviar los datos", error);
                
                mostrarMensaje("error", "Error de conexion con el servidor");
            }
        })
    </script>
</body>
</html>